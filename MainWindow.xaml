<Window x:Class="TMTestWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TMTestWpfApp"
        Title="Align Matching" Height="920" Width="2100"
        Background="#EEF2F5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SidebarTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DEE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SidebarCombo" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SidebarCheck" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#243447"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7C8F"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E4EBF1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#C9D4DE"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,5,2,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE4EB" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="btnBackToSettings" Content="◀ 모드" Click="BackToSettings_Click" MinWidth="72"
                        Background="#F4F7FA"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <Button Name="btnLoadSource" Content="대상 로드" Click="LoadSource_Click"
                        ToolTip="여러 장 선택 가능 (Ctrl/Shift)"/>
                <Button Name="btnCropSource" Content="대상 Crop" Click="CropSource_Click" IsEnabled="False"/>
                <Button Name="btnLoadTemplate" Content="템플릿 로드" Click="LoadTemplate_Click"
                        ToolTip="여러 장 선택 가능 (Ctrl/Shift)"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <Button Name="btnPreviewPreprocess" Content="ConvertToEdge 미리보기" Click="PreviewPreprocess_Click" IsEnabled="False"/>
                <Button Name="btnTestIntersection" Content="IntersectionPoint 테스트" Click="TestIntersectionPoint_Click" IsEnabled="False"
                        ToolTip="매칭 없이 현재 대상에서 V/H FitLine 교점만 계산합니다. Align Key 영역을 Crop해 두면 그 ROI로 동작하고, 템플릿이 있으면 이미지 중심 기준 템플릿 크기로 ROI를 잡습니다."/>
                <Button Name="btnMatch" Content="실행" Click="Match_Click" IsEnabled="False"
                        Background="#1F5C7A" Foreground="White" FontWeight="Bold" MinWidth="120"/>
                <Button Name="btnStopBatch" Content="중단" Click="StopBatch_Click" IsEnabled="False"
                        Background="#FDECEC" Foreground="#B71C1C" MinWidth="72"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <Button Name="btnOpenLog" Content="Log" Click="OpenLog_Click" MinWidth="72"
                        ToolTip="처리 로그를 별도 창으로 엽니다"/>
            </WrapPanel>
        </Border>

        <!-- Body: settings | workspace -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left settings sidebar ===== -->
            <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True"
                    BorderBrush="#D5E0EA" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar header -->
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#163A4F" Offset="0"/>
                                <GradientStop Color="#1F5C7A" Offset="0.55"/>
                                <GradientStop Color="#2A7A9B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="16,16,16,14">
                            <TextBlock Text="ALIGN SETTINGS" FontSize="10" FontWeight="Bold"
                                       Foreground="#8EC5DB"/>
                            <TextBlock x:Name="txtSettingsMode" Text="Fine Align" FontSize="20"
                                       FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtSettingsSubtitle" Text="0.25× → 1.0× → Refine"
                                       FontSize="11" Foreground="#C5E0EC" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Background="#F7FAFC" Padding="12">
                        <StackPanel>

                            <!-- Match -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="매칭" FontWeight="Bold" FontSize="13" Foreground="#1A3348"/>
                                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cboMatchType" Style="{StaticResource SidebarCombo}" SelectedIndex="0">
                                        <ComboBoxItem Content="CCORR"/>
                                        <ComboBoxItem Content="CCOEFF"/>
                                        <ComboBoxItem Content="SQDIFF"/>
                                    </ComboBox>
                                    <TextBlock Text="Threshold" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtThreshold" Style="{StaticResource SidebarTextBox}" Text="0.7"/>
                                </StackPanel>
                            </Border>

                            <!-- Fine options -->
                            <Border x:Name="panelFineSettings" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Fine 옵션" FontWeight="Bold" FontSize="13" Foreground="#1A3348"/>
                                    <TextBlock Text="Edge⊕Normal 가중 합산 (항상 적용)"
                                               FontSize="11" Foreground="#8A9AAB" Margin="0,0,0,4"/>

                                    <StackPanel x:Name="panelEdgeWeights">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Edge Weight" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                                <TextBox x:Name="txtEdgeWeight" Style="{StaticResource SidebarTextBox}" Text="5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Normal Weight" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                                <TextBox x:Name="txtNormalWeight" Style="{StaticResource SidebarTextBox}" Text="5"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="FineAlignSearchSize (px)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtFineSearchSize" Style="{StaticResource SidebarTextBox}" Text="2000"/>
                                </StackPanel>
                            </Border>

                            <!-- Coarse note -->
                            <Border x:Name="panelCoarseSettings" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Coarse 옵션" FontWeight="Bold" FontSize="13" Foreground="#1A3348"/>
                                    <TextBlock Text="Normal MatchTemplate만 사용합니다. Edge 전처리는 없습니다."
                                               FontSize="11" Foreground="#5B6B7C" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Refine -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Refine" FontWeight="Bold" FontSize="13" Foreground="#1A3348"/>
                                    <CheckBox x:Name="chkUseIntersection" Style="{StaticResource SidebarCheck}"
                                              Content="UseIntersectionPoint"
                                              ToolTip="V/H FitLine 교점으로 중심 Refine"
                                              IsChecked="True"
                                              Checked="UseIntersection_Changed" Unchecked="UseIntersection_Changed"/>
                                    <StackPanel x:Name="panelKeyDir">
                                        <TextBlock Text="RefineZoom" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cboRefineZoom" Style="{StaticResource SidebarCombo}" SelectedIndex="0"
                                                  ToolTip="중심 crop을 확대한 이미지로 에지 탐색 (Off=줌 없음)">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="2×"/>
                                            <ComboBoxItem Content="4×"/>
                                        </ComboBox>
                                        <TextBlock Text="AlignKeyDir" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cboKeyDir" Style="{StaticResource SidebarCombo}" SelectedIndex="0">
                                            <ComboBoxItem Content="LeftTop"/>
                                            <ComboBoxItem Content="LeftBottom"/>
                                            <ComboBoxItem Content="RightTop"/>
                                            <ComboBoxItem Content="RightBottom"/>
                                        </ComboBox>
                                        <TextBlock Text="EdgeLevel  [0 ~ 255]" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Sobel 응답 임계값. 이 값 이상인 픽셀만 에지로 채택. (기본 60)"/>
                                        <TextBox x:Name="txtEdgeLevel" Style="{StaticResource SidebarTextBox}" Text="60"
                                                 LostFocus="txtEdgeLevel_LostFocus"/>
                                        <TextBlock Text="EdgeInterval  [1 ~ 100]  px" Style="{StaticResource FieldLabel}"
                                                   ToolTip="아웃라이어 제거 허용 범위(픽셀). 클수록 퍼진 에지도 포함. (기본 3)"/>
                                        <TextBox x:Name="txtEdgeInterval" Style="{StaticResource SidebarTextBox}" Text="3"
                                                 LostFocus="txtEdgeInterval_LostFocus"/>
                                        <TextBlock Text="EdgeSearchRatio  [0.01 ~ 1.0]" Style="{StaticResource FieldLabel}"
                                                   ToolTip="ROI 중 에지를 탐색할 비율. (기본 0.6667)"/>
                                        <TextBox x:Name="txtEdgeSearchRatio" Style="{StaticResource SidebarTextBox}" Text="0.6667"
                                                 LostFocus="txtEdgeSearchRatio_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Output -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="출력" FontWeight="Bold" FontSize="13" Foreground="#1A3348"/>
                                    <CheckBox x:Name="chkSaveImages" Style="{StaticResource SidebarCheck}"
                                              Content="처리 이미지 저장"
                                              ToolTip="SearchArea, 매칭 박스, Refine 등 과정 이미지"
                                              IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <!-- Pipeline hint -->
                            <Border Background="#EAF3F8" CornerRadius="10" Padding="12" BorderBrush="#C9DEE9" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="파이프라인" FontWeight="Bold" FontSize="12" Foreground="#1F5C7A"/>
                                    <TextBlock x:Name="txtPipelineHint" Margin="0,6,0,0"
                                               FontSize="11" Foreground="#3D5A6C" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="txtSettingsLive" Margin="2,8,2,4"
                                       FontSize="10" Foreground="#7A8B9C" TextWrapping="Wrap"
                                       Text="설정은 실행 시 바로 반영됩니다."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Workspace ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1F5C7A" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock x:Name="txtModeBanner" Foreground="White" FontWeight="SemiBold" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:ImageViewControl x:Name="SourceImageView" Grid.Row="0" Title="대상"/>
                        <Border x:Name="panelBatch" Grid.Row="1" Margin="0,8,0,0" BorderBrush="#CCCCCC"
                                BorderThickness="1" Background="White" Visibility="Collapsed" MaxHeight="200"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F0F4F7" Padding="8,5" CornerRadius="6,6,0,0">
                                    <TextBlock x:Name="txtBatchHeader" Text="배치 작업" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <ListBox x:Name="lstBatchTargets" Grid.Row="1" BorderThickness="0"
                                         SelectionChanged="BatchJob_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#888"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <local:ImageViewControl x:Name="TemplateImageView" Grid.Column="2" Title="템플릿"/>
                    <local:ImageViewControl x:Name="ResultImageView" Grid.Column="4" Title="결과"
                                            PixelZoomEnabled="True"/>

                    <Border Grid.Column="6" BorderBrush="#D5DEE6" BorderThickness="1" Background="#FAFBFC" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#1F5C7A" Padding="10,7" CornerRadius="8,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="txtProcessHeader" Text="처리 과정" Foreground="White"
                                               FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="항목을 클릭하면 결과에 표시" Foreground="#B8D4E3"
                                               FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="lstProcessSteps" Grid.Row="1" BorderThickness="0"
                                     Background="Transparent"
                                     SelectionChanged="ProcessStep_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="6,4,6,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Card" Background="White" BorderBrush="#E0E4E8"
                                                            BorderThickness="1" CornerRadius="4" Padding="8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#1F5C7A"/>
                                                            <Setter TargetName="Card" Property="Background" Value="#F3F8FB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#1F5C7A"/>
                                                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="Card" Property="Background" Value="#E8F2F7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                        Background="{Binding BadgeBrush}" VerticalAlignment="Center"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StepBadge}" Foreground="White"
                                                               FontWeight="Bold" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               FontSize="12" TextWrapping="Wrap" Foreground="#1A1A1A"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                               Foreground="#6B7280" TextWrapping="Wrap" Margin="0,1,0,0"
                                                               Visibility="{Binding SubtitleVisibility}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="36,6,0,0" Visibility="{Binding PairPanelVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#EEF3F7" BorderBrush="#D5DEE6" BorderThickness="1"
                                                        CornerRadius="3" Padding="6,8" Cursor="Hand"
                                                        MouseLeftButtonUp="ProcessStepPart_Click"
                                                        Tag="{Binding FilePath}">
                                                    <TextBlock Text="{Binding LeftLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#1F5C7A" HorizontalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Background="#EEF3F7" BorderBrush="#D5DEE6"
                                                        BorderThickness="1" CornerRadius="3" Padding="6,8" Cursor="Hand"
                                                        MouseLeftButtonUp="ProcessStepPart_Click"
                                                        Tag="{Binding RightFilePath}">
                                                    <TextBlock Text="{Binding RightLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#1F5C7A" HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Name="btnOpenHistory" Content="결과 폴더 열기"
                                    Click="OpenHistory_Click" IsEnabled="False" Margin="6"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DCE4EB" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtStatus" Grid.Row="0"
                           Text="대상과 템플릿 이미지를 로드한 뒤 실행을 누르세요."
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ProgressBar x:Name="progressBar" Grid.Row="1" Height="8" Margin="0,6,0,0"
                             Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
