<Window x:Class="TMTestWpfApp.AlignSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align 설정" Height="780" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="txtTitle" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="txtSubtitle" FontSize="12" Foreground="#666666" Margin="0,2,0,16"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="FindAlignKey 옵션 (원본 VEGA-D)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="14,10" CornerRadius="3">
                    <StackPanel>
                        <StackPanel x:Name="panelCoarse" Visibility="Collapsed">
                            <TextBlock Text="Coarse는 Normal MatchTemplate만 사용합니다 (전처리 없음)."
                                       FontSize="12" Foreground="#444444" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="panelFine" Visibility="Collapsed">
                            <TextBlock Text="EdgeTemplateMatching: ConvertToEdge ⊕ Normal 가중 합산 (항상 사용)"
                                       FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock Text="Edge: Gaussian(k=3,σ=1) → 7×7 box-gradient."
                                       Margin="0,4,0,8" FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>

                            <StackPanel x:Name="panelEdgeWeights" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Edge Weight" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtEdgeWeight" Width="60" Text="5"/>
                                <TextBlock Text="  Normal Weight" Style="{StaticResource ParamLabel}" Margin="14,0,8,0"/>
                                <TextBox x:Name="txtNormalWeight" Width="60" Text="5"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="FineAlignSearchSize" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtFineSearchSize" Width="80" Text="2000"/>
                                <TextBlock Text="  px (초기 탐색 창)" Style="{StaticResource ParamLabel}" Foreground="#888888"/>
                            </StackPanel>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="chkUseIntersection" Content="UseIntersectionPoint (V/H FitLine 교점으로 Refine)"
                                      IsChecked="True" VerticalAlignment="Center"
                                      Checked="UseIntersection_Changed" Unchecked="UseIntersection_Changed"/>
                        </StackPanel>

                        <StackPanel x:Name="panelRefineParams" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="AlignKeyDir" Style="{StaticResource ParamLabel}"/>
                                <ComboBox x:Name="cboKeyDir" Width="140" SelectedIndex="0">
                                    <ComboBoxItem Content="LeftTop"/>
                                    <ComboBoxItem Content="LeftBottom"/>
                                    <ComboBoxItem Content="RightTop"/>
                                    <ComboBoxItem Content="RightBottom"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="RefineZoom" Style="{StaticResource ParamLabel}"/>
                                <ComboBox x:Name="cboRefineZoom" Width="80" SelectedIndex="0">
                                    <ComboBoxItem Content="0 (없음)"/>
                                    <ComboBoxItem Content="2×"/>
                                    <ComboBoxItem Content="4×"/>
                                </ComboBox>
                                <TextBlock Text="  중심 1/N crop → 원본 크기 resize" Style="{StaticResource HintText}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="EdgeLevel" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtEdgeLevel" Width="60" Text="60"/>
                                <TextBlock Text="  Sobel 응답 임계값 (기본 60)" Style="{StaticResource HintText}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="EdgeInterval" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtEdgeInterval" Width="60" Text="3"/>
                                <TextBlock Text="  아웃라이어 제거 허용 범위 px (기본 3)" Style="{StaticResource HintText}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="EdgeSearchRatio" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtEdgeSearchRatio" Width="60" Text="0.6667"/>
                                <TextBlock Text="  에지 탐색 범위 비율 0.0〜1.0 (기본 0.6667)" Style="{StaticResource HintText}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <CheckBox x:Name="chkSaveImages" Content="처리 이미지 저장 (SearchArea / 매칭 / Refine)"
                                  IsChecked="True" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="ROI 시드 (원본 CRect 중심 기준)" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="14,10" CornerRadius="3">
                    <TextBlock FontSize="12" Foreground="#444444" TextWrapping="Wrap">
                        이전 스케일 중심을 새 ROI의 중심으로 사용합니다.
                        ROI 크기: template+8 (x1.0). 실패 시 즉시 중단.
                    </TextBlock>
                </Border>

                <TextBlock Text="매칭 배율 (고정)" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="14,10" CornerRadius="3">
                    <TextBlock x:Name="txtScales" FontSize="13"/>
                </Border>

                <TextBlock Text="실행 순서 (요약)" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                <Border Background="#F5F5F5" Padding="14,10" CornerRadius="3">
                    <TextBlock x:Name="txtPipelineHint" TextWrapping="Wrap" FontSize="12" Foreground="#444444"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="뒤로" MinWidth="100" Padding="14,8" Margin="0,0,8,0" Click="Back_Click"/>
            <Button Content="계속 (매칭 화면)" MinWidth="160" Padding="14,8" FontWeight="SemiBold"
                    Click="Continue_Click" Background="#E3F2FD"/>
        </StackPanel>
    </Grid>
</Window>
